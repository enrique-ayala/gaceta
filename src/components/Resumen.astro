---
import CajaCamara from './CajaCamara.astro';
import { fechaLarga, type Resumen } from '../lib/resumenes';
interface Props { r: Resumen; etiqueta?: string }
const { r, etiqueta } = Astro.props;
const d = r.data;
const estado = {
  si: { txt: 'Hay sesión', cls: 'si', ic: '🟢' },
  no: { txt: 'Sin sesión', cls: 'no', ic: '⚪' },
  sin_datos: { txt: 'No se pudo confirmar', cls: 'sd', ic: '🟡' },
} as const;
const chips = [
  { n: 'Diputados', s: estado[d.diputados.sesion] },
  { n: 'Senado', s: estado[d.senado.sesion] },
];
---
<article>
  <p class="fecha">{etiqueta ? `${etiqueta} · ` : ''}{fechaLarga(r.id)}</p>
  <h1>{d.titular}</h1>

  <div class="sesion" role="group" aria-label="¿Hay sesión hoy?">
    <span class="q">¿Hay sesión hoy?</span>
    {chips.map((c) => (
      <span class={`chip ${c.s.cls}`}><span aria-hidden="true">{c.s.ic}</span> <strong>{c.n}:</strong> {c.s.txt}</span>
    ))}
  </div>

  {d.avisos.length > 0 && (
    <aside class="avisos">
      {d.avisos.map((a) => <p>⚠️ {a}</p>)}
    </aside>
  )}

  <CajaCamara nombre="Diputados" icono="🟦" clase="dip" data={d.diputados} />
  <CajaCamara nombre="Senado" icono="🟥" clase="sen" data={d.senado} />

  {d.destacado && (
    <section class="destacado">
      <h2>⭐ Tema destacado: {d.destacado.titulo}</h2>
      <p>{d.destacado.texto}</p>
    </section>
  )}

  <section class="fuentes">
    <h2>Fuentes</h2>
    <ul>
      {d.fuentes.map((f) => (
        <li>
          <a href={f.url}>{f.nombre}</a>{!f.leida && <span class="nolei"> (no se pudo leer)</span>}
        </li>
      ))}
    </ul>
  </section>
</article>
<style>
  .sesion { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin: 1rem 0; padding: .75rem 1rem; background: var(--card); border: 1px solid var(--line); border-radius: 10px; }
  .q { font-weight: 700; margin-right: .5rem; }
  .chip { font-size: .95rem; padding: .15rem .65rem; border-radius: 999px; border: 1px solid var(--line); }
  .chip.si { background: var(--ok-bg); color: var(--ok-fg); border-color: transparent; }
  .chip.sd { background: var(--aviso-bg); color: var(--aviso-fg); border-color: transparent; }
  .avisos { margin: 1rem 0; padding: .1rem 1rem; background: var(--aviso-bg); color: var(--aviso-fg); border-radius: 10px; font-size: .95rem; }
  .destacado { margin: 2rem 0; padding: 0 1.1rem 1rem; border: 2px solid var(--accent); border-radius: 10px; }
  .destacado h2 { border: 0; }
  .fuentes ul { padding-left: 1.2rem; font-size: .9rem; }
  .nolei { color: var(--muted); }
</style>
