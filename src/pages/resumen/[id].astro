---
import Base from '../../layouts/Base.astro';
import Resumen from '../../components/Resumen.astro';
import Navegacion from '../../components/Navegacion.astro';
import { todos, titulo, fechaLarga } from '../../lib/resumenes';

export async function getStaticPaths() {
  const rs = await todos();
  return rs.map((r, i) => ({
    params: { id: r.id },
    props: { r, anterior: rs[i + 1], siguiente: rs[i - 1] },
  }));
}

const { r, anterior, siguiente } = Astro.props;
---
<Base title={`${fechaLarga(r.id)} · El Congreso, explicado fácil`}>
  <Resumen r={r} />
  <Navegacion anterior={anterior} siguiente={siguiente} />
</Base>
