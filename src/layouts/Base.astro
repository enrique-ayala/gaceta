---
interface Props { title: string; description?: string }
const { title, description = 'Lo que pasa en el Congreso de México, explicado fácil, cada mañana.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header class="top">
      <a href={`${base}/`} class="marca">🏛️ El Congreso, explicado fácil</a>
      <a href={`${base}/archivo/`}>Todos los resúmenes</a>
    </header>
    <main><slot /></main>
    <footer>
      Resumen automático hecho con IA a partir de la Gaceta Parlamentaria, el Senado y el Canal del Congreso.
      Puede tener errores: revisa siempre las fuentes al final de cada resumen.
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7; --fg: #1d1d1b; --muted: #5f5d57; --line: #e4e1d8;
    --accent: #7a1f2b; --card: #ffffff; --code: #f1eee6;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151514; --fg: #ecebe6; --muted: #a8a59c; --line: #34332f;
      --accent: #e48a95; --card: #1d1d1b; --code: #262522;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font: 18px/1.65 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  main, .top, footer { max-width: 46rem; margin: 0 auto; padding: 0 16px; }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; padding-top: 1.25rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--line); font-size: .95rem; }
  .marca { font-weight: 700; color: var(--fg); text-decoration: none; }
  a { color: var(--accent); }
  h1 { font-size: 1.9rem; line-height: 1.2; margin: 2rem 0 .5rem; }
  h2 { font-size: 1.3rem; margin: 2.25rem 0 .5rem; padding-bottom: .25rem; border-bottom: 1px solid var(--line); }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; display: block; overflow-x: auto; }
  th, td { text-align: left; padding: .5rem .6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; }
  li { margin: .35rem 0; }
  code { background: var(--code); padding: .1em .3em; border-radius: 4px; font-size: .9em; }
  article a { overflow-wrap: anywhere; }
  hr { border: 0; border-top: 1px solid var(--line); margin: 2rem 0; }
  .fecha { color: var(--muted); font-size: .95rem; margin: 0; }
  footer { color: var(--muted); font-size: .85rem; margin-top: 4rem; padding-top: 1.5rem; padding-bottom: 2.5rem; border-top: 1px solid var(--line); }
</style>
